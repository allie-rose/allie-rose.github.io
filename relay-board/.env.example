# Copy this file to .env and fill in your key to turn on AI mode.
# Without a key the agents run on the built-in offline rules engine.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling.
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# PORT=3000
# AGENT_MODE=offline   # force the rules engine even when a key is set
